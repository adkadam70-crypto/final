			function checkScrollPosition() {
			const body = document.body;
			const logos = document.querySelectorAll('.navbar-brand img');

			if (window.pageYOffset <= 180 && body.classList.contains('index')) {
			body.classList.add('top');
			logos.forEach(logo => {
			logo.src = '/_resources/images/spring-arbor-logo__whitefull.svg';
			});
			} else {
			body.classList.remove('top');
			logos.forEach(logo => {
			logo.src = '/_resources/images/spring-arbor-logo__bluefull.svg';
			});
			}
			}
			window.addEventListener('load', checkScrollPosition);
			window.addEventListener('scroll', checkScrollPosition);
			window.addEventListener('resize', checkScrollPosition);
		</script>
