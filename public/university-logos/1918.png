      <main class="main-content" role="main">
         <article>
            <header id="page-title" tabindex="-1">
               <p id="skpmain"></p>
               <h1><span class="sub-title">Welcome to</span><span class="title" translate="no">Southwestern College</span></h1>
               <div class="header-links"><a href="https://catalog.swccd.edu/" class="button black" target="_blank">SWC Catalog</a><span translate="no"><a href="/administration/advancement-and-community-engagement/jaguar-journey.aspx" class="button black">Jaguar Journey</a></span><a href="/about-swc/get-in-touch/index.aspx" class="button black">Get in Touch</a></div>
            </header>
            <section class="whats-possible desktop">
               <div class="skew">
                  <div class="skew-background" style="background-image: url(/_resources/images/swc/meta/homepage-image.aspx);"><span class="accessible-alt-text">Image of Graduate Holding Diploma</span><div class="mobile" style="background-image: url();"></div>
                  </div>
               </div>
               <div class="geometry">
                  <div class="left-top"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="100%" height="100%" fill="currentcolor" preserveAspectRatio="none">
                        <path d="M0 64 L64 64 L64 58 L32 0 L0 0"/></svg></div>
                  <div class="left-bottom"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="100%" height="100%" fill="currentcolor" preserveAspectRatio="none">
                        <path d="M0 64 L44 64 L31 0 L0 0"/></svg></div>
                  <div class="bottom"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="100%" height="100%" fill="currentcolor" preserveAspectRatio="none">
                        <path d="M0 64 L71 64 L44 22 L0 42"/></svg></div>
